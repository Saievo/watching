# 美股盯盘系统配置文件
# 复制此文件为 .env 并填入你的实际配置

# ── 方式一：简单模式（所有股票使用同一策略） ──────────────────────
# SYMBOLS=AAPL,TSLA,NVDA
# INTERVAL=15m
# DEFAULT_STRATEGY=macd_rsi

# ── 方式二：每股独立配置（格式：股票代码,策略名,时间周期） ──────────
# 策略名可选: macd_rsi | rsi_only | ma_cross | tsla_aggressive | nvda_macd | full
STOCK_0=AAPL,macd_rsi,15m
STOCK_1=TSLA,tsla_aggressive,15m
STOCK_2=NVDA,nvda_macd,15m
STOCK_3=SPY,ma_cross,1h
STOCK_4=QQQ,ma_cross,1h

# Bark 推送链接（替换为你自己的 Bark Key）
BARK_URL=https://api.day.app/your_bark_key/

# 日志级别（DEBUG, INFO, WARNING, ERROR）
LOG_LEVEL=INFO
